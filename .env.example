# Public site URL — used for metadata, canonical links and OG images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated, ordered list of tab sources to query.
# Available: local
TAB_PROVIDERS=local

# Upstream request timeout in milliseconds.
TAB_FETCH_TIMEOUT_MS=8000

# Accounts. Both or neither — one without the other throws at startup, because a
# half-configured deployment would silently keep everyone's tabs in a browser
# while its operator believed there were accounts. With neither set the app runs
# without accounts, which is also how the e2e suite runs: offline.
#
# Both are public by design. The anon key is meant to be shipped to browsers;
# what protects the data is row-level security, in
# supabase/migrations/0001_accounts_and_tabs.sql.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
