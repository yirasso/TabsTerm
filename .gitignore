# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# copied from node_modules at build time
/public/models/

# Personal working files: editor settings, AI assistant instructions, design
# tooling and planning notes. None of it is needed to install, run, test or
# build the app — it describes how one person works, not what the project is.
/.vscode/
/.idea/
/.claude/
/.cursor/
/.impeccable/
.cursorrules
.windsurfrules
.aider*
AGENTS.md
PRODUCT.md
/docs/PLAN.md

# CLAUDE.md is deliberately NOT ignored. It is the one working note worth
# sharing: the rules a contributor would otherwise have to rediscover, each
# with the failure that put it there.
